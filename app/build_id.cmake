# Writes sereneds_build_id.h (app + core commits) only when it changes, so builds stay incremental.
# Run at build time by the sereneds_build_id target in CMakeLists.txt.
function(commit dir var)
    execute_process(COMMAND git -C ${dir} rev-parse --short=8 HEAD OUTPUT_VARIABLE h OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
    execute_process(COMMAND git -C ${dir} status --porcelain --untracked-files=no -- . OUTPUT_VARIABLE d OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
    if(NOT h)
        set(h unknown)
    endif()
    if(d)
        set(h "${h}-dirty")
    endif()
    set(${var} ${h} PARENT_SCOPE)
endfunction()
commit(${APP} app)
commit(${LIB} lib)
# A live savestate handoff requires stricter compatibility than the package version.
# Include the native source revisions and every cached emulator feature switch. This
# is a compatibility fingerprint, not proof that two binaries are byte-identical.
set(native_options "")
if(EXISTS "${CACHE}")
    file(STRINGS "${CACHE}" native_options
         REGEX "^(LITEV_[A-Z0-9_]+|ENABLE_JIT|ENABLE_OGLRENDERER|ANDROID_ABI|CMAKE_BUILD_TYPE):")
    list(SORT native_options)
else()
    set(app "${app}-nocache")
endif()
set(native_settings "")
foreach(option IN LISTS native_options)
    set(native_settings "${native_settings}${option}\n")
endforeach()
list(FIND native_options "LITEV_PGO_USE:BOOL=ON" pgo_enabled)
if(NOT pgo_enabled EQUAL -1 AND EXISTS "${PROFILE}")
    file(SHA256 "${PROFILE}" profile_digest)
    set(native_settings "${native_settings}PGO_PROFILE=${profile_digest}\n")
endif()
string(SHA256 handoff_digest "sereneds-live-handoff-v1\n${app}\n${lib}\n${native_settings}")
string(SUBSTRING "${handoff_digest}" 0 16 handoff_hex)
set(clean 1)
if(app MATCHES "-dirty|-nocache" OR lib MATCHES "-dirty")
    set(clean 0)
endif()
set(text "#define SERENEDS_BUILD_ID \"app ${app} lib ${lib}\"\n#define SERENEDS_HANDOFF_BUILD_ID 0x${handoff_hex}ULL\n#define SERENEDS_HANDOFF_BUILD_CLEAN ${clean}\n")
if(EXISTS ${OUT})
    file(READ ${OUT} old)
endif()
if(NOT "${old}" STREQUAL "${text}")
    file(WRITE ${OUT} "${text}")
endif()
